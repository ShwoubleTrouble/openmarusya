# --- LLM: DeepSeek через неофициального провайдера (OpenAI-совместимый) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=200
LLM_HISTORY_TURNS=8

# --- HTTP ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_TOKEN=change-me

# --- STT: faster_whisper (в докере) | whisper_cpp (CLI) ---
STT_ENGINE=faster_whisper
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_COMPUTE=int8
FASTER_WHISPER_DIR=/models/hf

# whisper.cpp (если STT_ENGINE=whisper_cpp)
WHISPER_BIN=/usr/bin/whisper-cli
WHISPER_MODEL=/opt/models/ggml-small.bin
WHISPER_LANG=ru
WHISPER_THREADS=0

# --- TTS: piper | espeak ---
TTS_ENGINE=piper
PIPER_BIN=/usr/bin/piper
PIPER_MODEL=/opt/models/ru_RU-irina-medium.onnx
ESPEAK_VOICE=ru
ESPEAK_SPEED=160
